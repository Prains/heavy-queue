#!/usr/bin/env python3
"""Cap how many heavy Bash commands run at once across all Claude Code sessions.

  heavy-queue acquire   PreToolUse hook: wait for a free slot, then take a lease
  heavy-queue release   PostToolUse/PostToolUseFailure hook: drop the lease;
                        Stop/SubagentStop hook: drop every lease of that agent
  heavy-queue status    list current leases

The command itself is never rewritten, so permission rules keep matching it,
and time spent waiting doesn't count against the Bash tool timeout.
"""
import fcntl
import json
import os
import re
import sys
import time
from pathlib import Path

PLUGIN_ROOT = Path(__file__).resolve().parent.parent
STATE = Path(os.environ.get("HEAVY_QUEUE_DIR", Path.home() / ".cache" / "heavy-queue"))
SLOTS = int(os.environ.get("HEAVY_QUEUE_SLOTS", max(1, (os.cpu_count() or 4) // 4)))
# Last resort for leases nobody released, e.g. a turn interrupted by the user. Must stay
# above BASH_MAX_TIMEOUT_MS (10 min by default), or a long build loses its slot mid-run.
TTL = int(os.environ.get("HEAVY_QUEUE_TTL", 15 * 60))
USER_PATTERNS = Path.home() / ".config" / "heavy-queue" / "patterns"
# `{cmd}` in a pattern: where a command starts, so `cat vitest.config.ts` doesn't count as vitest.
CMD = (
    r"(?:^|(?<!\\)[;&|(\n]|\$\()\s*"
    r"(?:\w+=\S*\s+|(?:timeout|gtimeout)\s+\S+\s+|(?:time|nice|env|exec)\s+)*"
    r"(?:(?:npx|bunx|bun\s+x|bun|pnpm\s+(?:exec|dlx)|yarn|uv\s+run|poetry\s+run|python3?\s+-m)\s+(?:-\S+\s+)*)?"
    r"(?:\S*/)?"
)


def owner(event):
    """Leases are keyed by agent, so an agent's leftovers can be found and dropped."""
    return re.sub(r"[^\w-]", "_", f"{event['session_id']}.{event.get('agent_id', 'main')}")


def heavy_pattern():
    files = [USER_PATTERNS if USER_PATTERNS.exists() else PLUGIN_ROOT / "patterns"]
    # A project can add its own patterns on top, committed with the repo.
    files.append(Path(os.environ.get("CLAUDE_PROJECT_DIR", ".")) / ".claude" / "heavy-queue-patterns")
    lines = [l.strip() for f in files if f.exists() for l in f.read_text().splitlines()]
    lines = [l.replace("{cmd}", CMD) for l in lines if l and not l.startswith("#")]
    return re.compile("|".join(f"(?:{l})" for l in lines)) if lines else None


def live_leases():
    now = time.time()
    leases = []
    for p in STATE.glob("*.lease"):
        try:
            if now - p.stat().st_mtime > TTL:
                p.unlink()
            else:
                leases.append(p)
        except FileNotFoundError:
            pass
    return leases


def acquire(event):
    tool_input = event["tool_input"]
    command = tool_input.get("command", "")
    pattern = heavy_pattern()
    # Background commands return immediately, so their lease would be released at once.
    if tool_input.get("run_in_background") or not pattern or not pattern.search(command):
        return
    STATE.mkdir(parents=True, exist_ok=True)
    lease = STATE / f"{owner(event)}.{event['tool_use_id']}.lease"
    # ponytail: polling, not FIFO; add ordered tickets if waiters ever starve
    while True:
        with open(STATE / ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            # An agent runs its heavy commands one at a time, so a lease it still holds
            # belongs to a call that ended without PostToolUse (denied by another hook,
            # permission prompt refused, cancelled).
            for p in STATE.glob(f"{owner(event)}.*.lease"):
                p.unlink(missing_ok=True)
            if len(live_leases()) < SLOTS:
                lease.write_text(command)
                return
        time.sleep(1)


def release(event):
    tool_use_id = event.get("tool_use_id", "*")
    for p in STATE.glob(f"{owner(event)}.{tool_use_id}.lease"):
        p.unlink(missing_ok=True)


def status():
    leases = live_leases() if STATE.exists() else []
    print(f"{len(leases)}/{SLOTS} slots busy")
    for p in leases:
        print(f"  {time.time() - p.stat().st_mtime:5.0f}s  {p.read_text()[:100]}")


if __name__ == "__main__":
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    if action == "status":
        status()
    elif action in ("acquire", "release"):
        {"acquire": acquire, "release": release}[action](json.load(sys.stdin))
    else:
        sys.exit(f"usage: {sys.argv[0]} acquire|release|status")
